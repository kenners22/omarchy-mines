pkgname=mines
pkgver=0.1.0
pkgrel=1
pkgdesc='A mine-clearing puzzle for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/mines "$pkgdir/usr/bin/mines"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/mines.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mines.svg"
  install -Dm644 "$startdir/mines.desktop" "$pkgdir/usr/share/applications/mines.desktop"
}
